[Unit]
Description=Pokemon Price Tracker Streamlit App
After=network.target

[Service]
Type=simple
User=pokemon
WorkingDirectory=/opt/pokemon
ExecStart=/opt/pokemon/venv/bin/streamlit run app/main.py --server.port 8502 --server.headless true --server.baseUrlPath pokemon
EnvironmentFile=/opt/pokemon/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
