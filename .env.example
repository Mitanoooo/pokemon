# Path to the SQLite database file
DB_PATH=pokemon.db

# Gmail account used to send digest emails
GMAIL_USER=you@gmail.com

# Gmail App Password (not your login password — generate at myaccount.google.com > Security > App passwords)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Address the digest email is sent to
DIGEST_TO=you@example.com

# Optional: set this path to write the digest to a local HTML file instead of sending via SMTP
# Useful for testing before email is configured. Leave blank (or unset) for real sending.
DIGEST_FILE_TRANSPORT=
DISCORD_WEBHOOK_URL=
